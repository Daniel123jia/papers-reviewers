# Copy to .env on your computer. NEVER commit .env.
OPENAI_API_KEY=
# Enter an exact Responses API model ID available to your API account.
OPENAI_MODEL=
# Model must support PDF/image input. Check support for reasoning effort.
REVIEW_EFFORT=high
REVIEW_MAX_OUTPUT_TOKENS=32000
REVIEW_TIMEOUT_SECONDS=900
# Optional: USD per 1M tokens, verify current model pricing first.
# Leave blank to report token use without a cost estimate.
REVIEW_INPUT_USD_PER_MTOK=
REVIEW_OUTPUT_USD_PER_MTOK=
